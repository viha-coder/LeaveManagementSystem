@model LeaveManagementSystem.Web.Data.LeaveType

@{
    ViewData["Title"] = "Create";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header text-white border-0" style="background: linear-gradient(135deg,#0d6efd 0%,#6610f2 100%);">
                    <h1 class="h3 mb-1">Create Leave Type</h1>
                    <p class="mb-0 opacity-75">Add a new leave type to the system.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Name" class="control-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="NumberOfDays" class="control-label fw-semibold"></label>
                            <input asp-for="NumberOfDays" class="form-control" />
                            <span asp-validation-for="NumberOfDays" class="text-danger"></span>
                        </div>
                        <div class="d-flex gap-2">
                            <input type="submit" value="Create" class="btn btn-primary" />
                            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
