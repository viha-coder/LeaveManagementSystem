@model IEnumerable<LeaveManagementSystem.Web.Data.LeaveType>

@{
    ViewData["Title"] = "Index";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">Leave Types</h1>
            <p class="text-muted mb-0">Manage the leave options available to employees.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header text-white border-0" style="background: linear-gradient(135deg,#0d6efd 0%,#6610f2 100%);">
            <h2 class="h5 mb-0">Available Leave Types</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Name)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.NumberOfDays)
                        </th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
@foreach (var item in Model) {
                    <tr>
                        <td class="fw-semibold">
                            @Html.DisplayFor(model => item.Name)
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary-emphasis">@Html.DisplayFor(model => item.NumberOfDays) days</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
}
                </tbody>
            </table>
        </div>
    </div>
</div>
