@model LeaveManagementSystem.Web.Data.LeaveType

@{
    ViewData["Title"] = "Delete";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white border-0">
                    <h1 class="h3 mb-1">Delete Leave Type</h1>
                    <p class="mb-0 opacity-75">This action cannot be undone.</p>
                </div>
                <div class="card-body p-4">
                    <h3 class="h5 mb-4">Are you sure you want to delete this?</h3>
                    <dl class="row mb-4">
                        <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Name)</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.Name)</dd>
                        <dt class="col-sm-5">@Html.DisplayNameFor(model => model.NumberOfDays)</dt>
                        <dd class="col-sm-7">@Html.DisplayFor(model => model.NumberOfDays)</dd>
                    </dl>
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <input type="submit" value="Delete" class="btn btn-danger" />
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to List</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
