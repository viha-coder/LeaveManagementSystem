@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    .hero-privacy {
        background: linear-gradient(135deg,#6c757d 0%,#343a40 100%);
        color: #fff;
        border-radius: .5rem;
        padding: 2.5rem 1.25rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 6px 24px rgba(0,0,0,.10);
    }
    .policy-section { margin-bottom: 1rem }
    .policy-meta { font-size:.95rem; color:#6c757d }
</style>

<div class="hero-privacy">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="h3 fw-bold">Privacy Policy</h1>
                <p class="mb-0">This policy describes how the leave management system collects, uses and protects data related to employees and leave requests.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <a asp-controller="Home" asp-action="Index" class="btn btn-light">Voltar ao Início</a>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">Overview</h5>
                    <p class="policy-section">We collect and process personal data necessary to manage leave requests, approvals and employment compliance. We handle data confidentially and only for as long as required for the purposes described.</p>

                    <h5 class="card-title">Data we collect</h5>
                    <ul>
                        <li>Identification: name, email address, employee number/ID, date of birth.</li>
                        <li>HR data: position, manager, department and leave/allocation history.</li>
                        <li>Requests: start/end dates, type of absence, reason and attachments (e.g., medical certificate).</li>
                        <li>Operational records: timestamps, approver comments and audit logs.</li>
                    </ul>

                    <h5 class="card-title">Purpose and legal basis</h5>
                    <p class="policy-section">We process your data to:</p>
                    <ul>
                        <li>Enable you to request leave and allow managers to review and approve those requests.</li>
                        <li>Fulfill legal and contractual obligations arising from the employment relationship.</li>
                        <li>Generate reports and statements for leave, absences and compliance purposes.</li>
                    </ul>

                    <h5 class="card-title">Data sharing</h5>
                    <p class="policy-section">Access to data is restricted to authorized personnel such as the employee, managers, HR staff and system administrators. We may share data with vendors that support operations (e.g., email delivery, file storage) under contracts that require data protection.</p>

                    <h5 class="card-title">Retention</h5>
                    <p class="policy-section">We retain leave records and related data for as long as necessary for the processing purpose, legal requirements or internal policies (e.g., employment period + 5 years), in accordance with applicable law.</p>

                    <h5 class="card-title">Security</h5>
                    <p class="policy-section">We implement technical and organizational controls to protect data against unauthorized access, alteration or disclosure. Controls include authentication, role-based authorization, encrypted communication and audit logging.</p>

                    <h5 class="card-title">Your rights</h5>
                    <p class="policy-section">Depending on your jurisdiction you may have rights to access, correct or request deletion of your data. For requests, contact HR or the system administrator listed below.</p>

                    <h5 class="card-title">Changes to this policy</h5>
                    <p class="policy-section">We may update this policy periodically. Significant changes will be communicated via internal channels or by email.</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="card-title">Contato</h6>
                    <p class="mb-0 policy-meta">Equipe de RH / Administrador do Sistema</p>
                    <p class="mb-0">E-mail: <a href="mailto:privacidade@empresa.local">privacidade@empresa.local</a></p>
                    <p class="mb-0">Telefone: (00) 0 0000-0000</p>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Notas rápidas</h6>
                    <ul class="mb-0">
                        <li>Os anexos enviados são armazenados de forma segura.</li>
                        <li>Acesso a dados é registrado para auditoria.</li>
                        <li>Remova informações sensíveis de anexos quando possível.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Placeholder para funcionalidades futuras (ex.: mostrar histórico de versões da política)
        $(function () { /* noop */ });
    </script>
}

