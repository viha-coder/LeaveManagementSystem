@{
    ViewData["Title"] = "Home";
}

<style>
    .hero {
        background: linear-gradient(135deg,#0d6efd 0%,#6610f2 100%);
        color: #fff;
        border-radius: .5rem;
        padding: 3rem 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 6px 24px rgba(13,110,253,.12);
    }
    .stat-card { min-height:120px }
    .quick-actions .btn { min-width:160px }
    .table-small td, .table-small th { padding: .5rem .75rem }
</style>

<div class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h1 class="display-5 fw-bold">Leave Management System</h1>
                <p class="lead mb-4">Request time off, track approvals and manage your leave balance easily and securely.</p>
                <div class="d-flex gap-2 quick-actions">
                    <a asp-controller="LeaveRequests" asp-action="Create" class="btn btn-light btn-lg">Request Leave</a>
                    <a asp-controller="LeaveRequests" asp-action="Index" class="btn btn-outline-light btn-lg">My Requests</a>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-light btn-lg d-none d-md-inline">Admin Panel</a>
                </div>
            </div>
            <div class="col-md-5 text-center mt-4 mt-md-0">
                <div class="bg-white text-dark rounded p-3 shadow stat-card">
                    <div class="row">
                        <div class="col-4">
                            <h3 class="mb-0" data-count="12">0</h3>
                            <small class="text-muted">Days Remaining</small>
                        </div>
                        <div class="col-4">
                            <h3 class="mb-0" data-count="3">0</h3>
                            <small class="text-muted">Pending</small>
                        </div>
                        <div class="col-4">
                            <h3 class="mb-0" data-count="24">0</h3>
                            <small class="text-muted">Approved</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Request New Leave</h5>
                    <p class="card-text">Open a new leave or quick absence request.</p>
                    <a asp-controller="LeaveRequests" asp-action="Create" class="btn btn-primary">Request now</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Approvals</h5>
                    <p class="card-text">Track requests that require your attention as an approver.</p>
                    <a asp-controller="Approvals" asp-action="Index" class="btn btn-outline-primary">View Pending</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Reports</h5>
                    <p class="card-text">Generate leave usage reports and employee history.</p>
                    <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary">Open Reports</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">Recent Activity</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0 table-small">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>User</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>2026-09-20</td>
                                    <td>Mariana S.</td>
                                    <td>Vacation</td>
                                    <td><span class="badge bg-warning text-dark">Pending</span></td>
                                </tr>
                                <tr>
                                    <td>2026-09-18</td>
                                    <td>Rafael P.</td>
                                    <td>Home Office</td>
                                    <td><span class="badge bg-success">Approved</span></td>
                                </tr>
                                <tr>
                                    <td>2026-09-15</td>
                                    <td>Ana L.</td>
                                    <td>Medical Leave</td>
                                    <td><span class="badge bg-danger">Rejected</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header">Summary</div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">Annual balance: <strong>20 days</strong></li>
                        <li class="mb-2">Requests this year: <strong>6</strong></li>
                        <li class="mb-2">Awaiting approval: <strong>2</strong></li>
                    </ul>
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-outline-secondary mt-3">My Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Simple counter animation
            $('[data-count]').each(function () {
                var $el = $(this);
                var target = parseInt($el.data('count')) || 0;
                $({ countNum: 0 }).animate({ countNum: target }, {
                    duration: 900,
                    easing: 'swing',
                    step: function () {
                        $el.text(Math.floor(this.countNum));
                    },
                    complete: function () {
                        $el.text(this.countNum);
                    }
                });
            });
        });
    </script>
}
