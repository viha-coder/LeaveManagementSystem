@{
    ViewData["Title"] = "Início";
}

<style>
    .hero {
        background: linear-gradient(135deg,#0d6efd 0%,#6610f2 100%);
        color: #fff;
        border-radius: .5rem;
        padding: 3rem 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 6px 24px rgba(13,110,253,.12);
    }
    .stat-card { min-height:120px }
    .quick-actions .btn { min-width:160px }
    .table-small td, .table-small th { padding: .5rem .75rem }
</style>

<div class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h1 class="display-5 fw-bold">Sistema de Gestão de Férias</h1>
                <p class="lead mb-4">Solicite ausências, acompanhe aprovações e gerencie seu saldo de férias de forma simples e segura.</p>
                <div class="d-flex gap-2 quick-actions">
                    <a asp-controller="LeaveRequests" asp-action="Create" class="btn btn-light btn-lg">Solicitar Folga</a>
                    <a asp-controller="LeaveRequests" asp-action="Index" class="btn btn-outline-light btn-lg">Meus Pedidos</a>
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-light btn-lg d-none d-md-inline">Painel Admin</a>
                </div>
            </div>
            <div class="col-md-5 text-center mt-4 mt-md-0">
                <div class="bg-white text-dark rounded p-3 shadow stat-card">
                    <div class="row">
                        <div class="col-4">
                            <h3 class="mb-0" data-count="12">0</h3>
                            <small class="text-muted">Dias Restantes</small>
                        </div>
                        <div class="col-4">
                            <h3 class="mb-0" data-count="3">0</h3>
                            <small class="text-muted">Pendentes</small>
                        </div>
                        <div class="col-4">
                            <h3 class="mb-0" data-count="24">0</h3>
                            <small class="text-muted">Aprovadas</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Solicitar Nova Folga</h5>
                    <p class="card-text">Abra uma nova solicitação de férias ou ausência rápida.</p>
                    <a asp-controller="LeaveRequests" asp-action="Create" class="btn btn-primary">Solicitar agora</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Aprovações</h5>
                    <p class="card-text">Acompanhe pedidos que exigem sua atenção como aprovador.</p>
                    <a asp-controller="Approvals" asp-action="Index" class="btn btn-outline-primary">Ver Pendentes</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Relatórios</h5>
                    <p class="card-text">Gere relatórios de uso de férias e histórico por colaborador.</p>
                    <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary">Abrir Relatórios</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header">Atividades Recentes</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped mb-0 table-small">
                            <thead class="table-light">
                                <tr>
                                    <th>Data</th>
                                    <th>Usuário</th>
                                    <th>Tipo</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>2026-09-20</td>
                                    <td>Mariana S.</td>
                                    <td>Férias</td>
                                    <td><span class="badge bg-warning text-dark">Pendente</span></td>
                                </tr>
                                <tr>
                                    <td>2026-09-18</td>
                                    <td>Rafael P.</td>
                                    <td>Home Office</td>
                                    <td><span class="badge bg-success">Aprovado</span></td>
                                </tr>
                                <tr>
                                    <td>2026-09-15</td>
                                    <td>Ana L.</td>
                                    <td>Licença Médica</td>
                                    <td><span class="badge bg-danger">Rejeitado</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header">Resumo</div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">Saldo anual: <strong>20 dias</strong></li>
                        <li class="mb-2">Solicitações este ano: <strong>6</strong></li>
                        <li class="mb-2">Aguardando aprovação: <strong>2</strong></li>
                    </ul>
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-outline-secondary mt-3">Meu Perfil</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Simple counter animation
            $('[data-count]').each(function () {
                var $el = $(this);
                var target = parseInt($el.data('count')) || 0;
                $({ countNum: 0 }).animate({ countNum: target }, {
                    duration: 900,
                    easing: 'swing',
                    step: function () {
                        $el.text(Math.floor(this.countNum));
                    },
                    complete: function () {
                        $el.text(this.countNum);
                    }
                });
            });
        });
    </script>
}
